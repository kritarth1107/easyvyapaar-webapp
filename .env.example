# Mahajaan web app — copy to .env.local and adjust values.

# Backend API base URL (trailing slash optional)
NEXT_PUBLIC_API_URL=http://localhost:8080/api/

# Public URL of this Next.js app (SEO / canonical URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay: configured only on the backend (RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET).
# Checkout uses the public key returned from /api/billing/razorpay/create-order.
